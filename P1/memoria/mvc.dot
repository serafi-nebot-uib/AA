digraph MVC {
    graph [
        bgcolor="#ffffff"
        fontname="Helvetica"
        splines=polyline
        nodesep=0.6
        ranksep=0.5
        pad=0.5
    ]
    node [
        fontname="Helvetica"
        fontsize=13
        style="filled,rounded"
        shape=box
        margin="0.25,0.15"
    ]
    edge [
        fontname="Helvetica"
        fontsize=10
    ]

    // ── CONTROLLER ─────────────────────────────────────────
    subgraph cluster_controller {
        label="Controller"
        fontsize=15
        fontname="Helvetica Bold"
        style="filled,rounded"
        fillcolor="#f5f0dc"
        color="#baa84a"
        penwidth=2

        Controller [label="Controller", fillcolor="#eae8a8", color="#baa84a"]
    }

    // ── MODEL ──────────────────────────────────────────────
    subgraph cluster_model {
        label="Model"
        fontsize=15
        fontname="Helvetica Bold"
        style="filled,rounded"
        fillcolor="#dce8f5"
        color="#4a7eba"
        penwidth=2

        AlgorithmType [label="AlgorithmType", fillcolor="#a8c8ea", color="#4a7eba"]
        Measurement   [label="Measurement",   fillcolor="#a8c8ea", color="#4a7eba"]
        Model         [label="Model",         fillcolor="#a8c8ea", color="#4a7eba"]
    }

    // ── VIEW ───────────────────────────────────────────────
    subgraph cluster_view {
        label="View"
        fontsize=15
        fontname="Helvetica Bold"
        style="filled,rounded"
        fillcolor="#dcf5dc"
        color="#4aba4a"
        penwidth=2

        MainView     [label="MainView",      fillcolor="#a8eaa8", color="#4aba4a"]
        ControlPanel [label="ControlPanel",  fillcolor="#a8eaa8", color="#4aba4a"]
        GraphPanel   [label="GraphPanel",    fillcolor="#a8eaa8", color="#4aba4a"]
        ResultsPanel [label="ResultsPanel",  fillcolor="#a8eaa8", color="#4aba4a"]
    }

    // Force Model and View clusters to same vertical position
    Controller -> Model         [style=invis]
    Controller -> MainView      [style=invis]
    Model      -> _align        [style=invis]
    MainView   -> _align        [style=invis]
    _align [style=invis, width=0, height=0, label=""]

    // ── EDGES ──────────────────────────────────────────────

    // Model → View (ModelListener)
    Model -> MainView [
        label="  ModelListener\n  modelChanged()"
        color="#4a7eba"
        fontcolor="#4a7eba"
        style=dashed
        penwidth=1.5
    ]

    // View → Controller (ViewListener)
    ControlPanel -> Controller [
        label="  ViewListener\n  onStart/Stop/Predict…"
        color="#ba4a4a"
        fontcolor="#ba4a4a"
        penwidth=1.5
    ]

    // Controller → View
    Controller -> MainView [
        label="  setAlgorithmRunning()\n  showPredictions()"
        color="#baa84a"
        fontcolor="#baa84a"
        penwidth=1.5
    ]

    // Controller → Model
    Controller -> Model [
        label="  addMeasurement()\n  clearMeasurements()\n  predict()"
        color="#7a4aba"
        fontcolor="#7a4aba"
        penwidth=1.5
    ]

    // Controller uses AlgorithmType
    Controller -> AlgorithmType [
        label="  execute()"
        color="#7a4aba"
        fontcolor="#7a4aba"
        penwidth=1.5
    ]

    // MainView composes sub-panels
    MainView -> ControlPanel [color="#4aba4a" penwidth=1.2 style=dashed label="  contains"]
    MainView -> GraphPanel   [color="#4aba4a" penwidth=1.2 style=dashed label="  contains"]
    MainView -> ResultsPanel [color="#4aba4a" penwidth=1.2 style=dashed label="  contains"]

    // ControlPanel → GraphPanel (VisibilityListener, bypasses controller)
    ControlPanel -> GraphPanel [
        label="  VisibilityListener\n  setAlgorithmVisible()"
        color="#4aba4a"
        fontcolor="#4aba4a"
        style=dashed
        penwidth=1.5
    ]

    // Measurement uses AlgorithmType
    Measurement -> AlgorithmType [color="#4a7eba" penwidth=1.0 style=dashed label="  uses"]
}
